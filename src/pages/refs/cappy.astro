---
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import MainLayout from '@/layouts/Main.astro';

import Hero from '@/components/posts/Hero.astro';

import heroImg from '@/assets/refs/cappy/hero.jpg';

interface Props {}
---

<MainLayout>
  <Header title={'Ref'} />

  <div class="container mx-auto">
    <Hero
      imageSrc={heroImg.src}
      title="Cappy"
      description="Certified gremlin."
      size="sm"
    />
  </div>

  <!-- Content start -->
  <div class="container mx-auto my-4">
    <nav>
      <ul class="flex space-x-4">
        <li>
          <a href="#specs">Specs</a>
        </li>

        <li>
          <a href="#fits">Fits</a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="container mx-auto">refs</div>

  <!-- Content end -->

  <Footer />
</MainLayout>
