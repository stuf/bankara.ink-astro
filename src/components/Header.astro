---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import Icon from '@/components/Icon.astro';

const navLinks = [
  {
    href: '/',
    text: 'Home',
    hide: true,
  },
  {
    href: '/works',
    text: 'Works',
  },
  {
    href: '/about',
    text: 'About',
    hide: true,
  },
];
---

<header class="mb-4 max-sm:px-8">
  <div class="container mx-auto my-4 py-4">
    <nav class="flex space-x-6 items-center">
      <h2 class="text-2xl font-bold underline">
        <a href="/">バンカラ ・ bankara</a>
      </h2>

      <div class="space-x-2">
        {
          navLinks
            .filter(x => !x.hide)
            .map(it => <HeaderLink href={it.href}>{it.text}</HeaderLink>)
        }
      </div>

      <div class="grow text-right fill-black text-black">
        <ul class="inline-flex space-x-2">
          <li>
            <a href="https://twitter.com/piparkaq" class="external">
              <Icon icon="twitter" /> / @piparkaq
            </a>
          </li>

          <li>
            <a href="https://github.com/stuf" class="external">
              <Icon icon="github" /> / @stuf
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </div>
</header>

<style>
  @reference '@/styles/global.css';

  .external {
    @apply inline-block px-2 underline;
    @apply text-blue-500;
    @apply hover:bg-blue-500 hover:text-white;
  }
</style>
