---
import HeaderLink from './HeaderLink.astro';
import Icon from '@/components/Icon.astro';
import type { IconName } from '@/types';
import { isDev } from '@/env';

type HeaderLink = {
  href: string;
  text: string;
  icon?: IconName;
  hide?: boolean;
};

const navLinks: HeaderLink[] = [
  {
    href: '/',
    text: 'Home',
    hide: true,
  },
  {
    href: '/works',
    text: 'Works',
  },
  {
    href: '/journal',
    text: 'Journal',
    hide: true,
  },
];

const socials: HeaderLink[] = [
  {
    icon: 'twitter',
    href: 'https://twitter.com/piparkaq',
    text: '@piparkaq',
  },
  { icon: 'github', href: 'https://github.com/stuf', text: '@stuf' },
];
---

<header class="mb-4 max-sm:px-8">
  <div class="container mx-auto my-4 py-4">
    <nav class="flex space-x-6 items-center">
      <h2 class="text-2xl font-bold underline">
        <a href="/">バンカラ ・ bankara</a>
      </h2>

      <div class="space-x-2">
        {
          navLinks
            .filter(x => {
              if (isDev) {
                return true;
              }

              return !x.hide;
            })
            .map(it => (
              <HeaderLink href={it.href} ghost={it.hide && isDev}>
                {it.text}
              </HeaderLink>
            ))
        }
      </div>

      <div class="grow text-right fill-black text-black">
        <ul class="inline-flex space-x-2">
          {
            socials.map(it => (
              <li>
                <a class="external" href={it.href}>
                  {it.icon && <Icon icon={it.icon} />}
                  {it.text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>
</header>

<style>
  @reference '@/styles/global.css';

  .external {
    @apply inline-block px-2 underline;
    @apply text-blue-500;
    @apply hover:bg-blue-500 hover:text-white;
  }

  .nav-link {
  }

  .nav-link.hidden {
  }
</style>
