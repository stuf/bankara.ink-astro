---
// with TOC: mt-12 max-w-5/6 mx-auto grid grid-cols-4 gap-8
// without TOC: mt-12 max-w-5/6 mx-auto
interface Props {
  class?: string;
  showToc?: boolean;
}

const { showToc = true, class: className, ...rest } = Astro.props;
---

<div class:list={['base', className, showToc && 'with-toc']} {...rest}>
  <div class="body">
    <slot />
  </div>

  <div class="toc">
    <slot name="toc" />
  </div>
</div>

<style>
  @reference '@/styles/global.css';

  .base {
    @apply mt-12 mx-auto;
    @apply w-10/12;
    @apply sm:w-11/12;
  }

  .with-toc {
    @apply grid grid-cols-12 gap-2;
    @apply max-sm:block;
  }

  .with-toc .body {
    @apply col-span-8;
    @apply max-sm:order-2;
  }

  .with-toc .toc {
    @apply col-span-4;
    @apply max-sm:order-1;
  }
</style>
