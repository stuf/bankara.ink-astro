---
enum SizeEnum {
  SM = 'sm',
  MD = 'md',
  LG = 'lg',
}

type Size = `${SizeEnum}`;

interface Props {
  imageSrc: string;
  title: string;
  description: string;
  size?: Size;
}

const { imageSrc, title, description, size = 'md' } = Astro.props;

const sizeClass: Record<Size, string> = {
  sm: 'h-96',
  md: 'h-128',
  lg: 'h-[48rem]',
};
---

<!-- Post header/hero -->
<div
  class:list={['flex items-center bg-center pl-12 bg-cover', sizeClass[size]]}
  style={{ backgroundImage: `url(${imageSrc})` }}
>
  <div class="text-white text-shadow space-y-4">
    <h1 class="text-6xl">
      <span class="inline-block bg-black px-2 py-1">
        {title}
      </span>
    </h1>

    {
      description && (
        <p class="text-xl">
          <span class="inline-block bg-black px-2 py-1">{description}</span>
        </p>
      )
    }
  </div>
</div>
